{
  "name": "nchu-study-assistant",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "test": "npm run test:topic && npm run test:programs && npm run test:parser && npm run test:safety",
    "test:safety": "node scripts/test-ai-safety.mjs",
    "test:parser": "node scripts/test-transcript-parser.mjs",
    "test:programs": "node scripts/test-program-rules.mjs",
    "test:topic": "node scripts/test-learning-topic.mjs",
    "start": "node server.mjs",
    "serve": "npm run build && npm run start",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tailwindcss": "^4.2.3",
    "vite": "^8.0.9"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "gh-pages": "^6.3.0"
  }
}
